    <worksheet name='top5'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Top 5  Department Wise Sales</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='FACT_SALES (WALMARTDB.FACT_SALES)+ (WALMART_MART)' name='federated.03jh15v1h8sjvv0zsz9s519y3etd' />
          </datasources>
          <datasource-dependencies datasource='federated.03jh15v1h8sjvv0zsz9s519y3etd'>
            <column caption='Dept Id ' datatype='integer' name='[DEPT_ID (DIM_STORE)]' role='dimension' type='ordinal' />
            <column caption='Store Weekly Sales' datatype='real' name='[STORE_WEEKLY_SALES]' role='measure' type='quantitative' />
            <column-instance column='[DEPT_ID (DIM_STORE)]' derivation='None' name='[none:DEPT_ID (DIM_STORE):ok]' pivot='key' type='ordinal' />
            <column-instance column='[STORE_WEEKLY_SALES]' derivation='Sum' name='[sum:STORE_WEEKLY_SALES:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.03jh15v1h8sjvv0zsz9s519y3etd].[none:DEPT_ID (DIM_STORE):ok]'>
            <groupfilter count='5' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([STORE_WEEKLY_SALES])' function='order' user:ui-marker='order'>
                <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
                  <groupfilter function='member' level='[none:DEPT_ID (DIM_STORE):ok]' member='1' />
                  <groupfilter function='member' level='[none:DEPT_ID (DIM_STORE):ok]' member='2' />
                  <groupfilter function='member' level='[none:DEPT_ID (DIM_STORE):ok]' member='3' />
